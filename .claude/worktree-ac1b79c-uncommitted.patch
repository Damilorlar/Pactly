+  params: RequestAnchorChallengeParams,
+  fetchImpl: Sep10FetchLike = defaultFetch,
+): Promise<AnchorChallenge> {
+  const { webAuthEndpoint, signingKey, homeDomain, networkPassphrase, account } = params;
+
+  const challengeUrl = new URL(webAuthEndpoint);
+  challengeUrl.searchParams.set("account", account);
+
+  let challengeResponse: Pick<Response, "ok" | "status" | "json" | "text">;
+  try {
+    challengeResponse = await fetchImpl(challengeUrl.toString(), { method: "GET" });
+  } catch (cause) {
+    const reason = cause instanceof Error ? cause.message : String(cause);
+    throw new AnchorAuthError(`Could not reach ${homeDomain}'s SEP-10 endpoint: ${reason}`);
+  }
+  if (!challengeResponse.ok) {
+    const reason = await anchorReasonFromResponse(challengeResponse);
+    throw new AnchorAuthError(
+      `${homeDomain} refused the SEP-10 challenge request (HTTP ${challengeResponse.status})${reason ? `: ${reason}` : ""}`,
+    );
+  }
+  const challengeBody = (await readJson(challengeResponse, homeDomain)) as ChallengeResponseBody;
+  if (typeof challengeBody.transaction !== "string" || challengeBody.transaction.trim() === "") {
+    throw new AnchorAuthError(`${homeDomain}'s SEP-10 challenge response did not include a transaction`);
+  }
+  const responseNetworkPassphrase =
+    typeof challengeBody.network_passphrase === "string" ? challengeBody.network_passphrase : networkPassphrase;
+  if (responseNetworkPassphrase !== networkPassphrase) {
+    throw new AnchorAuthError(
+      `${homeDomain}'s SEP-10 challenge declared network_passphrase "${responseNetworkPassphrase}", expected "${networkPassphrase}"`,
+    );
+  }
+  const challengeXdr = challengeBody.transaction;
+
+  let clientAccountID: string;
+  try {
+    ({ clientAccountID } = WebAuth.readChallengeTx(challengeXdr, signingKey, networkPassphrase, homeDomain, challengeUrl.host));
+  } catch (cause) {
+    const reason = cause instanceof Error ? cause.message : String(cause);
+    throw new AnchorAuthError(`${homeDomain}'s SEP-10 challenge did not pass validation: ${reason}`);
+  }
+  if (clientAccountID !== account) {
+    throw new AnchorAuthError(
+      `${homeDomain}'s SEP-10 challenge names account "${clientAccountID}", but this exchange is for "${account}"`,
+    );
+  }
+
+  return { transaction: challengeXdr, networkPassphrase: responseNetworkPassphrase };
+}
+
+export interface SubmitAnchorChallengeParams {
+  webAuthEndpoint: string;
+  signingKey: string;
+  homeDomain: string;
+  networkPassphrase: string;
+  /** The wallet this signed challenge must belong to -- checked by
+   * re-deriving `clientAccountID` from the signed envelope itself (the same
+   * SDK reader, never trusting a caller-supplied value) before this backend
+   * ever relays anything to the anchor. */
+  expectedAccount: string;
+}
+
+/**
+ * Relays a client-wallet-signed anchor challenge and returns the anchor's
+ * JWT. Refuses (typed {@link AnchorAuthError}) before any network access if
+ * the signed envelope does not decode as a valid challenge from this
+ * anchor, does not carry `expectedAccount`'s own signature, or names a
+ * different account than `expectedAccount` -- the same signer-mismatch
+ * discipline `services/auth.ts`'s `getOrRefreshAnchorJwt` enforces for the
+ * managed-account path, applied here to a client-signed one instead.
+ */
+export async function submitAnchorChallenge(
+  params: SubmitAnchorChallengeParams,
+  signedTransactionXdr: string,
+  fetchImpl: Sep10FetchLike = defaultFetch,
+): Promise<AnchorSep10Result> {
+  const { webAuthEndpoint, signingKey, homeDomain, networkPassphrase, expectedAccount } = params;
+  const webAuthHost = new URL(webAuthEndpoint).host;
+
+  let clientAccountID: string;
+  try {
+    ({ clientAccountID } = WebAuth.readChallengeTx(signedTransactionXdr, signingKey, networkPassphrase, homeDomain, webAuthHost));
+  } catch (cause) {
+    const reason = cause instanceof Error ? cause.message : String(cause);
+    throw new AnchorAuthError(`This signed challenge did not pass validation: ${reason}`);
+  }
+  if (clientAccountID !== expectedAccount) {
+    throw new AnchorAuthError(
+      `This signed challenge names account "${clientAccountID}", but this exchange is for "${expectedAccount}"`,
+    );
+  }
+  try {
+    WebAuth.verifyChallengeTxSigners(signedTransactionXdr, signingKey, networkPassphrase, [clientAccountID], homeDomain, webAuthHost);
+  } catch (cause) {
+    const reason = cause instanceof Error ? cause.message : String(cause);
+    throw new AnchorAuthError(`This signed challenge is missing ${expectedAccount}'s own signature: ${reason}`);
+  }
+
+  let tokenResponse: Pick<Response, "ok" | "status" | "json" | "text">;
+  try {
+    tokenResponse = await fetchImpl(webAuthEndpoint, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({ transaction: signedTransactionXdr }),
+    });
+  } catch (cause) {
+    const reason = cause instanceof Error ? cause.message : String(cause);
+    throw new AnchorAuthError(`Could not reach ${homeDomain}'s SEP-10 endpoint: ${reason}`);
+  }
+  if (!tokenResponse.ok) {
+    const reason = await anchorReasonFromResponse(tokenResponse);
+    throw new AnchorAuthError(
+      `${homeDomain} rejected the signed SEP-10 challenge (HTTP ${tokenResponse.status})${reason ? `: ${reason}` : ""}`,
+    );
+  }
+  const tokenBody = (await readJson(tokenResponse, homeDomain)) as TokenResponseBody;
+  if (typeof tokenBody.token !== "string" || tokenBody.token.trim() === "") {
+    throw new AnchorAuthError(`${homeDomain}'s SEP-10 response did not include a token`);
+  }
+
+  return { token: tokenBody.token, expiresAt: decodeJwtExpiryMs(tokenBody.token, homeDomain) };
+}
