+/**
+ * Story 2.4: the anchor's SEP-12 (KYC) exchange did not complete as
+ * expected -- unreachable, a non-OK response, or a body this backend cannot
+ * make sense of. The sandbox always auto-approves with no personal data, so
+ * this is never thrown on the happy path; it exists for a real anchor that
+ * genuinely refuses, or for the network itself failing. Never a raw anchor
+ * body -- the anchor's own `error` field, when present, is what this
+ * carries.
+ */
+export class AnchorKycError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AnchorKycError";
+  }
+}
+
+/**
+ * Story 2.4: the anchor's SEP-6 deposit-side exchange (opening a deposit,
+ * polling its transaction, or the sandbox simulate call) did not complete --
+ * unreachable, a non-OK response, or a body missing what this backend needs.
+ * Carries the anchor's own reason where it supplied one, same discipline as
+ * {@link AnchorAuthError}.
+ */
+export class AnchorDepositError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AnchorDepositError";
+  }
+}
+
+/**
+ * Story 2.4: the anchor (or a discovery step this story depends on, such as
+ * `stellar.toml` or the SEP-38 indicative price used for the limit check)
+ * could not be reached at all -- distinct from {@link AnchorAuthError}/
+ * {@link AnchorKycError}/{@link AnchorDepositError}, which all mean the
+ * anchor *answered*, just not successfully. The route maps this to the same
+ * "your deposit is untouched" shape every other unreachable-dependency error
+ * in this codebase uses.
+ */
+export class AnchorUnavailableError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "AnchorUnavailableError";
+  }
+}
