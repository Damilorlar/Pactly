+  holdExpiresAt: number | null;
+  /** `true` only when a poll could not reach the anchor and this is the
+   * booking's own last-known status instead (I/O matrix: "Anchor
+   * unreachable: last known status plus stale: true"). */
+  stale?: true;
+  /** `true` alongside `unsignedTrustlineXdr` whenever the wallet still needs
+   * a USDC trustline -- at open time, or later if the anchor's own
+   * transaction reports `pending_trust` (spec: "handled the same way if it
+   * appears"). */
+  needsTrustline?: true;
+  unsignedTrustlineXdr?: string;
+}
+
+function parseBankDetails(json: string | null): LocalDepositBankDetails | undefined {
+  if (!json) return undefined;
+  try {
+    return JSON.parse(json) as LocalDepositBankDetails;
+  } catch {
+    return undefined;
+  }
+}
+
+function bankDetailsFromInstructions(instructions: Record<string, { value: string }>): LocalDepositBankDetails {
+  return {
+    bankName: instructions.bank_name?.value,
+    accountNumber: instructions.bank_account_number?.value,
+  };
+}
+
+/** Builds the response shape every branch below returns, from a booking's
+ * own currently-persisted anchor-deposit columns plus whatever this call's
+ * own fresher status/message/holdExpiresAt/trustline info is -- the one
+ * place that assembly happens, so the "open" and "poll" paths (and poll's
+ * own `pending_trust`/`stale` branches) can never drift into two different
+ * response shapes for the same stored data. */
+function buildLocalDepositView(
+  booking: BookingRow,
+  overrides: {
+    status: LocalDepositStatus;
+    message: string;
+    moreInfoUrl?: string;
+    holdExpiresAt: number | null;
+    stale?: true;
+    needsTrustline?: true;
+    unsignedTrustlineXdr?: string;
+  },
+): LocalDepositView {
+  return {
+    status: overrides.status,
+    message: overrides.message,
+    reference: booking.anchorDepositReference ?? undefined,
+    bankDetails: parseBankDetails(booking.anchorDepositBankDetails),
+    amount:
+      booking.anchorDepositAmountIn && booking.anchorDepositCurrency
+        ? { amount: booking.anchorDepositAmountIn, currency: booking.anchorDepositCurrency }
+        : undefined,
+    moreInfoUrl: overrides.moreInfoUrl ?? booking.anchorDepositMoreInfoUrl ?? undefined,
+    holdExpiresAt: overrides.holdExpiresAt,
+    ...(overrides.stale ? { stale: true as const } : {}),
+    ...(overrides.needsTrustline ? { needsTrustline: true as const, unsignedTrustlineXdr: overrides.unsignedTrustlineXdr } : {}),
+  };
+}
+
+/** Extends the hold the same {@link HOLD_DURATION_SECONDS} window every
+ * other extension in this file uses, from `now` -- the spec's own "Always"
+ * rule ("extended to now + 10 minutes on every poll that still shows
+ * progress"), applied the moment a deposit opens and on every poll that
+ * still shows progress. */
+function extendedHoldExpiresAt(now: number): number {
+  return now + HOLD_DURATION_SECONDS;
+}
+
+/** Builds the client's own unsigned change-trust transaction and wraps the
+ * result in the `needsTrustline` response shape -- shared by
+ * {@link openLocalDeposit} and {@link getLocalDepositStatus}'s own
+ * `pending_trust` branch. */
+async function buildNeedsTrustlineView(
+  booking: BookingRow,
+  usdc: UsdcAsset,
+  deps: AnchorLocalDepositDeps,
+  status: LocalDepositStatus,
+  message: string,
+  holdExpiresAt: number | null,
+): Promise<LocalDepositView> {
+  const built = await buildChangeTrustTransaction(booking.clientWalletAddress, usdc.code, usdc.issuer, { getAccount: deps.getAccount });
+  return buildLocalDepositView(booking, { status, message, holdExpiresAt, needsTrustline: true, unsignedTrustlineXdr: built.unsignedXdr });
+}
+
+/**
+ * `POST /bookings/:id/deposit/local`: opens (or returns the already-open, or
+ * retries after a `failed`) SEP-6 deposit for exactly this booking's own
+ * escrow `depositAmount`, converted to the anchor's own local currency via
+ * its SEP-38 indicative rate (this module's own small seam -- never an
+ * import of `anchor/sep38.ts`, Story 2.2's own module landing in parallel).
+ *
+ * Order matches the spec's own "Always" bullets: the limit check runs
+ * first (a read-only SEP-38/SEP-6-info lookup, refused with typed
+ * {@link AnchorAmountOutOfRangeError} before any SEP-12/deposit-opening
+ * call), then the trustline check (refused with `needsTrustline` if
+ * absent -- the caller re-calls this with `signedTrustlineXdr` once the
+ * client has signed the returned transaction, which this function submits
+ * and waits on before continuing in the very same call), then the anchor
+ * session check (typed {@link AnchorSessionRequiredError}), then SEP-12,
+ * then the SEP-6 deposit itself.
+ *
+ * Refused (typed {@link BookingHoldExpiredError}) once the hold has expired.
+ */
+export async function openLocalDeposit(
+  db: Db,
+  bookingId: string,
+  walletAddress: string,
+  signedTrustlineXdr: string | undefined,
+  deps: AnchorLocalDepositDeps = {},
+): Promise<LocalDepositView> {
+  const now = deps.now ?? Math.floor(Date.now() / 1000);
+  const booking = await getBookingForClient(db, bookingId, walletAddress);
+  requireHoldNotExpired(booking, now);
+
+  if (booking.anchorDepositId && booking.anchorDepositStatus !== "error") {
+    return buildLocalDepositView(booking, {
+      status: mapAnchorStatus(booking.anchorDepositStatus ?? "pending_user_transfer_start", booking.anchorDepositMessage ?? undefined).status,
+      message: booking.anchorDepositMessage ?? mapAnchorStatus(booking.anchorDepositStatus ?? "pending_user_transfer_start", undefined).message,
+      holdExpiresAt: booking.holdExpiresAt,
+    });
+  }
+
+  const usdc = await (deps.resolveUsdcAsset ?? resolveUsdcAsset)();
+  const usdcDecimal = smallestUnitToStellarAmount(booking.depositAmount);
+  const context = await requireAnchorContext(deps);
+
+  const localAsset = await discoverLocalCurrencyAsset(context.quoteServer, deps.anchorFetch);
+  const buyAsset = `stellar:${usdc.code}:${usdc.issuer}`;
+  const localAmount = await fetchAnchorIndicativeSellAmount(context.quoteServer, localAsset, buyAsset, usdcDecimal, deps.anchorFetch);
+  const currency = localAsset.replace(/^iso4217:/, "");
+
+  const info = await fetchAnchorDepositInfo(context.transferServer, usdc.code, deps.anchorFetch);
+  const belowMin = info.minAmount !== undefined && Number(localAmount) < Number(info.minAmount);
+  const aboveMax = info.maxAmount !== undefined && Number(localAmount) > Number(info.maxAmount);
+  if (belowMin || aboveMax) {
+    throw new AnchorAmountOutOfRangeError(info.minAmount, info.maxAmount, currency);
+  }
+
+  if (signedTrustlineXdr) {
+    await submitChangeTrustTransaction(signedTrustlineXdr, deps.submitTrustline ?? {});
+  }
+  const hasTrustline = await hasUsdcTrustline(booking.clientWalletAddress, usdc.code, usdc.issuer, { getTrustline: deps.getTrustline });
+  if (!hasTrustline) {
+    return buildNeedsTrustlineView(booking, usdc, deps, "awaiting_transfer", "Getting your wallet ready.", booking.holdExpiresAt);
+  }
+
+  const jwt = await getCachedAnchorJwt(db, booking.clientWalletAddress);
+  if (!jwt) {
+    throw new AnchorSessionRequiredError();
+  }
+
+  await ensureAnchorCustomerAccepted(context.kycServer, jwt, booking.clientWalletAddress, deps.anchorFetch);
+
+  const fundingMethod = info.fundingMethods[0];
+  if (!fundingMethod) {
+    throw new AnchorDepositError("The anchor did not advertise any way to fund a deposit.");
+  }
+
+  const opened = await openAnchorDeposit(
+    { transferServer: context.transferServer, jwt, assetCode: usdc.code, account: booking.clientWalletAddress, amount: localAmount, fundingMethod },
+    deps.anchorFetch,
+  );
+
+  const bankDetails = bankDetailsFromInstructions(opened.instructions);
+  const reference = opened.instructions.external_transfer_memo?.value;
+  const holdExpiresAt = extendedHoldExpiresAt(now);
+  await recordAnchorDepositOpened(
+    db,
+    bookingId,
+    {
+      id: opened.id,
+      status: "pending_user_transfer_start",
+      moreInfoUrl: opened.moreInfoUrl,
+      reference,
+      bankDetails: JSON.stringify(bankDetails),
+      amountIn: localAmount,
+      currency,
+    },
+    holdExpiresAt,
+    Date.now(),
+  );
+
+  return {
+    status: "awaiting_transfer",
+    message: "Waiting for your transfer.",
+    reference,
+    bankDetails,
+    amount: { amount: localAmount, currency },
+    moreInfoUrl: opened.moreInfoUrl,
+    holdExpiresAt,
+  };
+}
+
+/**
+ * `GET /bookings/:id/deposit/local`: the current status of an already-open
+ * local deposit, mapped to plain words (NFR9). Extends the hold on every
+ * poll that still shows progress (`pending_user_transfer_start`,
+ * `pending_anchor`, `pending_trust`); a `pending_trust` result also carries
+ * a fresh unsigned change-trust transaction, same as {@link openLocalDeposit}
+ * itself (spec: "handled the same way if it appears"). Falls back to the
+ * booking's own last-known status with `stale: true` if the anchor cannot
+ * be reached (typed {@link AnchorUnavailableError} from the client modules
+ * below), rather than failing the poll outright.
+ *
+ * Refused (typed {@link BookingEscrowStateError}) if no local deposit has
+ * ever been opened for this booking.
+ */
+export async function getLocalDepositStatus(
+  db: Db,
+  bookingId: string,
+  walletAddress: string,
+  deps: AnchorLocalDepositDeps = {},
+): Promise<LocalDepositView> {
+  const now = deps.now ?? Math.floor(Date.now() / 1000);
+  const booking = await getBookingForClient(db, bookingId, walletAddress);
+  if (!booking.anchorDepositId) {
+    throw new BookingEscrowStateError(`Booking "${bookingId}" has no local-currency deposit open yet; open one first`);
+  }
+
+  const context = await requireAnchorContext(deps);
+  const jwt = await getCachedAnchorJwt(db, booking.clientWalletAddress);
+  if (!jwt) {
+    throw new AnchorSessionRequiredError();
+  }
+
+  let tx;
+  try {
+    tx = await fetchAnchorDepositTransaction(context.transferServer, jwt, booking.anchorDepositId, deps.anchorFetch);
+  } catch (error) {
+    if (error instanceof AnchorUnavailableError) {
+      return buildLocalDepositView(booking, {
+        status: mapAnchorStatus(booking.anchorDepositStatus ?? "pending_user_transfer_start", booking.anchorDepositMessage ?? undefined).status,
+        message: booking.anchorDepositMessage ?? "Waiting for your transfer.",
+        holdExpiresAt: booking.holdExpiresAt,
+        stale: true,
+      });
+    }
+    throw error;
+  }
+
+  const mapped = mapAnchorStatus(tx.status, tx.message);
+  const stillPending = tx.status === "pending_user_transfer_start" || tx.status === "pending_anchor" || tx.status === "pending_trust";
+  const holdExpiresAt = stillPending ? extendedHoldExpiresAt(now) : booking.holdExpiresAt;
+  await updateAnchorDepositStatus(db, bookingId, tx.status, tx.message, Date.now(), stillPending ? holdExpiresAt ?? undefined : undefined);
+
+  if (tx.status === "pending_trust") {
+    const usdc = await (deps.resolveUsdcAsset ?? resolveUsdcAsset)();
+    return buildNeedsTrustlineView(booking, usdc, deps, mapped.status, mapped.message, holdExpiresAt);
+  }
+
+  return buildLocalDepositView(booking, { status: mapped.status, message: mapped.message, moreInfoUrl: tx.moreInfoUrl, holdExpiresAt });
+}
+
+/**
+ * `POST /bookings/:id/deposit/local/simulate`: the sandbox-only "Simulate
+ * the bank transfer" affordance. The route itself gates this to
+ * {@link SANDBOX_ANCHOR_HOME_DOMAIN} (spec: "On a non-sandbox anchor: 404")
+ * -- this function assumes that check already passed and simply relays the
+ * booking's own last-recorded local-currency amount to the anchor's own
+ * simulate endpoint. Refused (typed {@link BookingEscrowStateError}) if no
+ * local deposit has ever been opened for this booking.
+ */
+export async function simulateLocalDeposit(
+  db: Db,
+  bookingId: string,
+  walletAddress: string,
+  deps: AnchorLocalDepositDeps = {},
+): Promise<void> {
+  const booking = await getBookingForClient(db, bookingId, walletAddress);
+  if (!booking.anchorDepositId || !booking.anchorDepositAmountIn) {
+    throw new BookingEscrowStateError(`Booking "${bookingId}" has no local-currency deposit open yet; open one first`);
+  }
+  const context = await requireAnchorContext(deps);
+  await simulateAnchorBankTransfer(context.transferServer, booking.anchorDepositId, booking.anchorDepositAmountIn, deps.anchorFetch);
+}
